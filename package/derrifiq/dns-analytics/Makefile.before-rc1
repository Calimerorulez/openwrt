include $(TOPDIR)/rules.mk

PKG_NAME:=dns-analytics
PKG_VERSION:=2.1.1
PKG_RELEASE:=7

PKG_LICENSE:=MIT
PKG_MAINTAINER:=Patrick <chatgpt@derrifiq.nl>

include $(INCLUDE_DIR)/package.mk

define Package/dns-analytics
  SECTION:=utils
  CATEGORY:=Utilities
  TITLE:=DNS Analytics for AdGuard Home and collectd
  DEPENDS:=+curl +jq +jsonfilter +collectd-mod-exec +sqlite3-cli
  PKGARCH:=all

endef

define Package/dns-analytics/description
 DNS analytics collector for AdGuard Home with dynamic categorisation,
 daily Top 20 statistics, asynchronous AI classification, SQLite storage
 and collectd output.
endef

define Package/dns-analytics/conffiles
/etc/config/dns-analytics
/etc/dns-analytics/adguard.secret
/etc/dns-analytics/ai.secret
/etc/dns-analytics/categories.d/
endef

define Build/Compile
endef

define Package/dns-analytics/install
	$(INSTALL_DIR) $(1)/etc/config
	$(INSTALL_CONF) ./files/etc/config/dns-analytics \
		$(1)/etc/config/dns-analytics

	$(INSTALL_DIR) $(1)/etc/init.d
	$(INSTALL_BIN) ./files/etc/init.d/dns-analytics \
		$(1)/etc/init.d/dns-analytics

	$(INSTALL_DIR) $(1)/etc/dns-analytics/categories.d
	$(INSTALL_DATA) ./files/etc/dns-analytics/categories.d/README \
		$(1)/etc/dns-analytics/categories.d/README

	$(INSTALL_DIR) $(1)/usr/libexec/dns-analytics
	$(INSTALL_BIN) ./files/usr/libexec/dns-analytics/collector \
		$(1)/usr/libexec/dns-analytics/collector
	$(INSTALL_BIN) ./files/usr/libexec/dns-analytics/classifier \
		$(1)/usr/libexec/dns-analytics/classifier
	$(INSTALL_BIN) ./files/usr/libexec/dns-analytics/common.sh \
		$(1)/usr/libexec/dns-analytics/common.sh
	$(INSTALL_BIN) ./files/usr/libexec/dns-analytics/db-init \
		$(1)/usr/libexec/dns-analytics/db-init
	$(INSTALL_BIN) ./files/usr/libexec/dns-analytics/db-sync-rules \
		$(1)/usr/libexec/dns-analytics/db-sync-rules
	$(INSTALL_BIN) ./files/usr/libexec/dns-analytics/db-reclassify \
		$(1)/usr/libexec/dns-analytics/db-reclassify

	$(INSTALL_DIR) $(1)/usr/sbin
	$(INSTALL_BIN) ./files/usr/libexec/dns-analytics/review \
		$(1)/usr/sbin/dns-analytics-review
	$(INSTALL_BIN) ./files/usr/libexec/dns-analytics/selftest \
		$(1)/usr/sbin/dns-analytics-selftest

	$(INSTALL_DIR) $(1)/usr/share/dns-analytics/categories.d
	$(INSTALL_DATA) ./files/usr/share/dns-analytics/categories.d/* \
		$(1)/usr/share/dns-analytics/categories.d/

	$(INSTALL_DIR) $(1)/usr/share/dns-analytics
	$(INSTALL_DATA) ./files/usr/share/dns-analytics/category-aliases.tsv \
		$(1)/usr/share/dns-analytics/category-aliases.tsv
	$(INSTALL_DATA) ./files/usr/share/dns-analytics/schema.sql \
		$(1)/usr/share/dns-analytics/schema.sql

	$(INSTALL_DIR) $(1)/usr/share/doc/dns-analytics
	$(INSTALL_DATA) ./files/usr/share/doc/dns-analytics/README \
		$(1)/usr/share/doc/dns-analytics/README
endef

define Package/dns-analytics/postinst
#!/bin/sh

[ -n "$${IPKG_INSTROOT}" ] && exit 0

chown root:root /etc/config/dns-analytics
chmod 0644 /etc/config/dns-analytics

if [ -f /etc/dns-analytics/adguard.secret ]; then
        chown root:nogroup /etc/dns-analytics/adguard.secret
        chmod 0640 /etc/dns-analytics/adguard.secret
fi

existing="$$(uci -q show luci_statistics | \
	sed -n "s/^\(luci_statistics\.[^=]*\)=collectd_exec_input$$/\1/p" | \
	while read -r section; do
		cmdline="$$(uci -q get "$$section.cmdline")"

		if [ "$$cmdline" = "/usr/libexec/dns-analytics/collector" ]; then
			echo "$$section"
			break
		fi
	done)"

if [ -z "$$existing" ]; then
	section="$$(uci add luci_statistics collectd_exec_input)"

	uci set "luci_statistics.$$section.cmdline=/usr/libexec/dns-analytics/collector"
	uci set "luci_statistics.$$section.cmduser=nobody"
	uci set "luci_statistics.$$section.cmdgroup=nogroup"
	uci commit luci_statistics
fi

/etc/init.d/dns-analytics enable >/dev/null 2>&1

/etc/init.d/dns-analytics restart >/dev/null 2>&1
/etc/init.d/luci_statistics restart >/dev/null 2>&1

exit 0
endef

define Package/dns-analytics/prerm
#!/bin/sh

[ -n "$${IPKG_INSTROOT}" ] && exit 0

uci -q show luci_statistics | \
	sed -n "s/^\(luci_statistics\.[^=]*\)=collectd_exec_input$$/\1/p" | \
	while read -r section; do
		cmdline="$$(uci -q get "$$section.cmdline")"

		if [ "$$cmdline" = "/usr/libexec/dns-analytics/collector" ]; then
			uci -q delete "$$section"
		fi
	done

uci commit luci_statistics

/etc/init.d/dns-analytics stop >/dev/null 2>&1
/etc/init.d/dns-analytics disable >/dev/null 2>&1
/etc/init.d/luci_statistics restart >/dev/null 2>&1

exit 0
endef

$(eval $(call BuildPackage,dns-analytics))
