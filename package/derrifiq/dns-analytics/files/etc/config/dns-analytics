config general 'main'
	option enabled '1'
	option interval '60'
	option query_limit '5000'
	option top_limit '20'
	option collectd_host 'dobby'
	option collectd_plugin 'exec-dnscat'
	option state_dir '/etc/dns-analytics/data'
	option database '/etc/dns-analytics/data/dns-analytics.sqlite'
	option runtime_dir '/tmp/dns-analytics'

config adguard 'adguard'
	option url 'http://127.0.0.1:3000'
	option secret_file '/etc/dns-analytics/adguard.secret'

config classification 'classification'
	option enabled '0'
	option minimum_confidence '0.80'
	option maximum_per_cycle '5'
	option maximum_per_hour '30'
	option allow_new_categories '1'
	option auto_promote_categories '0'
	option promotion_min_domains '25'
	option promotion_min_confidence '0.90'
	option promotion_min_days '3'

config ai 'ai'
	option provider 'openai-compatible'
	option endpoint ''
	option model ''
	option secret_file '/etc/dns-analytics/ai.secret'
	option timeout '20'
