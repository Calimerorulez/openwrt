#!/bin/sh

set -eu

CONFIG="dns-analytics"
DEFAULT_STATE_DIR="/etc/dns-analytics/data"
SCHEMA="/usr/share/dns-analytics/schema.sql"

STATE_DIR="$(uci -q get "${CONFIG}.main.state_dir" 2>/dev/null || true)"
DATABASE="$(uci -q get "${CONFIG}.main.database" 2>/dev/null || true)"

[ -n "$STATE_DIR" ] || STATE_DIR="$DEFAULT_STATE_DIR"
[ -n "$DATABASE" ] || DATABASE="$STATE_DIR/dns-analytics.sqlite"

if [ ! -r "$SCHEMA" ]; then
        logger -t dns-analytics -- "Database-schema ontbreekt: $SCHEMA"
        exit 1
fi

mkdir -p "$STATE_DIR"
chown nobody:nogroup "$STATE_DIR"
chmod 0750 "$STATE_DIR"

migrate_domain_rules_v3() {
        [ -f "$DATABASE" ] || return 0

        columns="$(
                sqlite3 -batch -noheader "$DATABASE" \
                        "PRAGMA table_info(domain_rules);" 2>/dev/null |
                awk -F '|' '{ print $2 }'
        )"

        printf '%s\n' "$columns" | grep -qx 'domain' || return 0
        printf '%s\n' "$columns" | grep -qx 'pattern' && return 0

        logger -t dns-analytics -- \
                "Migreert domain_rules van schema v2 naar v3"

        sqlite3 -batch "$DATABASE" <<'SQL'
PRAGMA foreign_keys = OFF;
PRAGMA busy_timeout = 5000;

BEGIN IMMEDIATE;

ALTER TABLE domain_rules RENAME TO domain_rules_v2;

CREATE TABLE domain_rules (
    pattern             TEXT NOT NULL COLLATE NOCASE,
    match_type          TEXT NOT NULL DEFAULT 'suffix'
                                CHECK (match_type IN ('exact', 'suffix')),
    category_id         INTEGER NOT NULL REFERENCES categories(id)
                                ON UPDATE CASCADE
                                ON DELETE CASCADE,
    source              TEXT NOT NULL DEFAULT 'builtin',
    priority            INTEGER NOT NULL DEFAULT 100,
    enabled             INTEGER NOT NULL DEFAULT 1
                                CHECK (enabled IN (0, 1)),
    created_at          INTEGER NOT NULL DEFAULT (unixepoch()),
    updated_at          INTEGER NOT NULL DEFAULT (unixepoch()),
    PRIMARY KEY (pattern, match_type, source)
);

INSERT INTO domain_rules
(
    pattern,
    match_type,
    category_id,
    source,
    priority,
    enabled,
    created_at,
    updated_at
)
SELECT
    domain,
    'suffix',
    category_id,
    source,
    CASE
        WHEN source = 'local' THEN 1000
        ELSE 100
    END,
    1,
    created_at,
    updated_at
FROM domain_rules_v2;

DROP TABLE domain_rules_v2;

CREATE INDEX idx_domain_rules_category
    ON domain_rules(category_id);

CREATE INDEX idx_domain_rules_matching
    ON domain_rules(enabled, priority, match_type, pattern);

INSERT INTO metadata(key, value)
VALUES ('schema_version', '3')
ON CONFLICT(key) DO UPDATE SET value = excluded.value;

COMMIT;

PRAGMA foreign_keys = ON;
SQL
}

migrate_domain_rules_v3

sqlite3 -batch "$DATABASE" < "$SCHEMA" >/dev/null

chown nobody:nogroup \
        "$DATABASE" \
        "$DATABASE-wal" \
        "$DATABASE-shm" \
        2>/dev/null || true

chmod 0640 "$DATABASE"
chmod 0640 "$DATABASE-wal" "$DATABASE-shm" 2>/dev/null || true

logger -t dns-analytics -- "Database geïnitialiseerd: $DATABASE"
