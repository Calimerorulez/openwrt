#!/bin/sh
# shellcheck source=/dev/null

set -eu

. /usr/libexec/dns-analytics/common.sh

LOCAL_RULES="/etc/dns-analytics/categories.d/local.tsv"
DB_SYNC_RULES="/usr/libexec/dns-analytics/db-sync-rules"
DB_RECLASSIFY="/usr/libexec/dns-analytics/db-reclassify"

usage() {
	cat <<'USAGE'
Gebruik:
  dns-analytics-review list [aantal]
  dns-analytics-review show <domein>
  dns-analytics-review classify <domein> <categorie> [exact|suffix] [prioriteit]
  dns-analytics-review ignore <domein>
  dns-analytics-review reset <domein>

Voorbeelden:
  dns-analytics-review list 30
  dns-analytics-review show api.example.com
  dns-analytics-review classify example.com infrastructure/example suffix
  dns-analytics-review classify api.example.com infrastructure/example exact 1200
  dns-analytics-review ignore noisy.example.com
  dns-analytics-review reset noisy.example.com
USAGE
}

fail() {
	printf 'Fout: %s\n' "$*" >&2
	exit 1
}

require_root() {
	[ "$(id -u)" -eq 0 ] || fail "dit commando moet als root worden uitgevoerd"
}

validate_domain() {
	value="$(normalize_domain "$1")"

	[ -n "$value" ] || fail "leeg domein"

	case "$value" in
		*[!a-z0-9._:-]*)
			fail "ongeldig domein: $value"
			;;
	esac

	printf '%s\n' "$value"
}

validate_category() {
	value="$1"

	[ -n "$value" ] || fail "lege categorie"

	case "$value" in
		*[!a-zA-Z0-9._/-]*)
			fail "ongeldige categorie: $value"
			;;
	esac

	printf '%s\n' "$value"
}

list_unknown() {
	limit="${1:-30}"
	limit="$(safe_integer "$limit" 30)"

	[ "$limit" -gt 0 ] || limit=30
	[ "$limit" -le 500 ] || limit=500

	sqlite3 -header -column "$DATABASE" "
SELECT
    d.domain,
    d.query_count,
    d.classification_status,
    datetime(d.last_seen, 'unixepoch') AS last_seen_utc
FROM domains AS d
JOIN categories AS c
    ON c.id = d.category_id
WHERE c.name = 'unknown'
  AND d.classification_status <> 'ignored'
ORDER BY
    d.query_count DESC,
    d.domain COLLATE NOCASE
LIMIT $limit;
"
}

show_domain() {
	domain="$(validate_domain "$1")"
	q_domain="$(sql_quote "$domain")"

	sqlite3 -header -column "$DATABASE" "
SELECT
    d.domain,
    c.name AS category,
    d.query_count,
    d.classification_status,
    datetime(d.first_seen, 'unixepoch') AS first_seen_utc,
    datetime(d.last_seen, 'unixepoch') AS last_seen_utc
FROM domains AS d
JOIN categories AS c
    ON c.id = d.category_id
WHERE d.domain = '$q_domain'
COLLATE NOCASE;
"

	printf '\nRegelmatches:\n'

	sqlite3 -header -column "$DATABASE" "
SELECT
    dr.pattern,
    dr.match_type,
    c.name AS category,
    dr.source,
    dr.priority,
    dr.enabled
FROM domain_rules AS dr
JOIN categories AS c
    ON c.id = dr.category_id
WHERE dr.enabled = 1
  AND (
        (dr.match_type = 'exact'
         AND '$q_domain' = dr.pattern)
     OR (dr.match_type = 'suffix'
         AND (
                '$q_domain' = dr.pattern
             OR '$q_domain' LIKE '%.' || dr.pattern
         ))
  )
ORDER BY
    dr.priority DESC,
    CASE dr.match_type
        WHEN 'exact' THEN 2
        WHEN 'suffix' THEN 1
        ELSE 0
    END DESC,
    length(dr.pattern) DESC;
"
}

classify_domain() {
	require_root

	domain="$(validate_domain "$1")"
	category="$(validate_category "$2")"
	match_type="${3:-suffix}"
	priority="${4:-1000}"

	case "$match_type" in
		exact|suffix)
			;;
	*)
		fail "matchtype moet exact of suffix zijn"
		;;
	esac

	priority="$(safe_integer "$priority" -1)"
	[ "$priority" -ge 0 ] || fail "prioriteit moet een positief geheel getal zijn"
	[ "$priority" -le 100000 ] || fail "prioriteit is te hoog"

	ensure_directory "$(dirname "$LOCAL_RULES")"

	tmp_file="$RUNTIME_DIR/local-rules.$$"
	trap 'rm -f "$tmp_file"' EXIT INT TERM HUP

	if [ -f "$LOCAL_RULES" ]; then
		awk -F '\t' \
			-v pattern="$domain" \
			-v match_type="$match_type" '
			BEGIN {
				OFS = "\t"
			}

			/^#/ || NF == 0 {
				print
				next
			}

			!($1 == pattern && $2 == match_type) {
				print
			}
			' "$LOCAL_RULES" > "$tmp_file"
	else
		printf '# pattern\tmatch_type\tcategory\tpriority\n' > "$tmp_file"
	fi

	printf '%s\t%s\t%s\t%s\n' \
		"$domain" \
		"$match_type" \
		"$category" \
		"$priority" >> "$tmp_file"

	cp "$tmp_file" "$LOCAL_RULES"
	chmod 0644 "$LOCAL_RULES"

	q_domain="$(sql_quote "$domain")"

	sqlite3 "$DATABASE" "
UPDATE domains
SET classification_status = 'pending',
    updated_at = unixepoch()
WHERE domain = '$q_domain'
COLLATE NOCASE;
"

	"$DB_SYNC_RULES"
	"$DB_RECLASSIFY"

	printf 'Geclassificeerd: %s -> %s (%s, prioriteit %s)\n' \
		"$domain" \
		"$category" \
		"$match_type" \
		"$priority"
}

ignore_domain() {
	require_root

	domain="$(validate_domain "$1")"
	q_domain="$(sql_quote "$domain")"

	found="$(
		sqlite3 "$DATABASE" "
SELECT COUNT(*)
FROM domains
WHERE domain = '$q_domain'
COLLATE NOCASE;
"
	)"

	[ "$found" -gt 0 ] || fail "domein niet gevonden: $domain"

	sqlite3 "$DATABASE" "
BEGIN IMMEDIATE;

UPDATE domains
SET classification_status = 'ignored',
    updated_at = unixepoch()
WHERE domain = '$q_domain'
COLLATE NOCASE;

DELETE FROM classification_queue
WHERE domain_id IN (
    SELECT id
    FROM domains
    WHERE domain = '$q_domain'
    COLLATE NOCASE
);

COMMIT;
"

	printf 'Genegeerd: %s\n' "$domain"
}

reset_domain() {
	require_root

	domain="$(validate_domain "$1")"
	q_domain="$(sql_quote "$domain")"

	sqlite3 "$DATABASE" "
UPDATE domains
SET classification_status = 'pending',
    updated_at = unixepoch()
WHERE domain = '$q_domain'
COLLATE NOCASE;
"

	"$DB_RECLASSIFY"

	printf 'Reviewstatus opnieuw bepaald: %s\n' "$domain"
}

command="${1:-}"

case "$command" in
	list)
		list_unknown "${2:-30}"
		;;
	show)
		[ "$#" -eq 2 ] || fail "gebruik: dns-analytics-review show <domein>"
		show_domain "$2"
		;;
	classify)
		if [ "$#" -lt 3 ] || [ "$#" -gt 5 ]; then
			fail "gebruik: dns-analytics-review classify <domein> <categorie> [exact|suffix] [prioriteit]"
		fi

		classify_domain "$2" "$3" "${4:-suffix}" "${5:-1000}"
		;;
	ignore)
		[ "$#" -eq 2 ] || fail "gebruik: dns-analytics-review ignore <domein>"
		ignore_domain "$2"
		;;
	reset)
		[ "$#" -eq 2 ] || fail "gebruik: dns-analytics-review reset <domein>"
		reset_domain "$2"
		;;
	-h|--help|help|'')
		usage
		;;
	*)
		usage >&2
		exit 1
		;;
esac
