#!/bin/sh
# shellcheck source=/dev/null

set -eu

. /usr/libexec/dns-analytics/common.sh

LOCAL_RULES="/etc/dns-analytics/categories.d/local.tsv"
DB_SYNC_RULES="/usr/libexec/dns-analytics/db-sync-rules"
DB_RECLASSIFY="/usr/libexec/dns-analytics/db-reclassify"

usage() {
	cat <<'USAGE'
Gebruik:
  dns-analytics-review list [aantal]
  dns-analytics-review show <domein>
  dns-analytics-review categories
  dns-analytics-review stats
  dns-analytics-review classify <domein> <categorie> [exact|suffix] [prioriteit]
  dns-analytics-review unclassify <domein> [exact|suffix]
  dns-analytics-review ignore <domein>
  dns-analytics-review reset <domein>

Voorbeelden:
  dns-analytics-review list 30
  dns-analytics-review show api.example.com
  dns-analytics-review categories
  dns-analytics-review stats
  dns-analytics-review classify example.com infrastructure/example suffix
  dns-analytics-review classify api.example.com infrastructure/example exact 1200
  dns-analytics-review unclassify example.com suffix
  dns-analytics-review ignore noisy.example.com
  dns-analytics-review reset noisy.example.com
USAGE
}

fail() {
	printf 'Fout: %s\n' "$*" >&2
	exit 1
}

audit_log() {
	logger -t dns-analytics -- "$*"
}

require_root() {
	[ "$(id -u)" -eq 0 ] ||
		fail "dit commando moet als root worden uitgevoerd"
}

validate_domain() {
	value="$(normalize_domain "$1")"

	[ -n "$value" ] || fail "leeg domein"

	case "$value" in
		*[!a-z0-9._:-]*)
			fail "ongeldig domein: $value"
			;;
	esac

	printf '%s\n' "$value"
}

validate_category() {
	value="$1"

	[ -n "$value" ] || fail "lege categorie"

	case "$value" in
		*[!a-zA-Z0-9._/-]*)
			fail "ongeldige categorie: $value"
			;;
	esac

	printf '%s\n' "$value"
}

validate_match_type() {
	value="$1"

	case "$value" in
		exact|suffix)
			printf '%s\n' "$value"
			;;
		*)
			fail "matchtype moet exact of suffix zijn"
			;;
	esac
}

category_exists() {
	category="$1"
	q_category="$(sql_quote "$category")"

	sqlite3 "$DATABASE" "
SELECT COUNT(*)
FROM categories
WHERE name = '$q_category'
  AND enabled = 1;
"
}

local_rule_exists() {
	pattern="$1"
	match_type="$2"

	[ -f "$LOCAL_RULES" ] || {
		printf '0\n'
		return
	}

	awk -F '\t' \
		-v pattern="$pattern" \
		-v match_type="$match_type" '
		!/^#/ && NF >= 4 &&
		$1 == pattern &&
		$2 == match_type {
			found = 1
		}

		END {
			print found + 0
		}
		' "$LOCAL_RULES"
}

list_unknown() {
	limit="${1:-30}"
	limit="$(safe_integer "$limit" 30)"

	[ "$limit" -gt 0 ] || limit=30
	[ "$limit" -le 500 ] || limit=500

	sqlite3 -header -column "$DATABASE" "
SELECT
    d.domain,
    d.query_count,
    d.classification_status,
    datetime(d.last_seen, 'unixepoch') AS last_seen_utc
FROM domains AS d
JOIN categories AS c
    ON c.id = d.category_id
WHERE c.name = 'unknown'
  AND d.classification_status <> 'ignored'
ORDER BY
    d.query_count DESC,
    d.domain COLLATE NOCASE
LIMIT $limit;
"
}

list_categories() {
	sqlite3 -header -column "$DATABASE" "
SELECT
    name,
    display_name
FROM categories
WHERE enabled = 1
ORDER BY
    name COLLATE NOCASE;
"
}

show_stats() {
	printf '=== STATUSSEN ===\n'

	sqlite3 -header -column "$DATABASE" "
SELECT
    classification_status AS status,
    COUNT(*) AS domains
FROM domains
GROUP BY classification_status
ORDER BY domains DESC;
"

	printf '\n=== UNKNOWN ===\n'

	sqlite3 -header -column "$DATABASE" "
SELECT
    COUNT(*) AS domains,
    COALESCE(SUM(query_count), 0) AS queries
FROM domains AS d
JOIN categories AS c
    ON c.id = d.category_id
WHERE c.name = 'unknown';
"

	printf '\n=== LOKALE REGELS ===\n'

	if [ -f "$LOCAL_RULES" ]; then
		awk -F '\t' '
		!/^#/ && NF >= 4 {
			count++
		}

		END {
			printf "local_rules\n-----------\n%d\n", count + 0
		}
		' "$LOCAL_RULES"
	else
		printf 'local_rules\n-----------\n0\n'
	fi

	printf '\n=== TOP PENDING ===\n'

	sqlite3 -header -column "$DATABASE" "
SELECT
    d.domain,
    d.query_count
FROM domains AS d
JOIN categories AS c
    ON c.id = d.category_id
WHERE c.name = 'unknown'
  AND d.classification_status = 'pending'
ORDER BY
    d.query_count DESC,
    d.domain COLLATE NOCASE
LIMIT 10;
"
}

show_domain() {
	domain="$(validate_domain "$1")"
	q_domain="$(sql_quote "$domain")"

	found="$(
		sqlite3 "$DATABASE" "
SELECT COUNT(*)
FROM domains
WHERE domain = '$q_domain'
COLLATE NOCASE;
"
	)"

	[ "$found" -gt 0 ] || fail "domein niet gevonden: $domain"

	sqlite3 -header -column "$DATABASE" "
SELECT
    d.domain,
    c.name AS category,
    d.query_count,
    d.classification_status,
    datetime(d.first_seen, 'unixepoch') AS first_seen_utc,
    datetime(d.last_seen, 'unixepoch') AS last_seen_utc
FROM domains AS d
JOIN categories AS c
    ON c.id = d.category_id
WHERE d.domain = '$q_domain'
COLLATE NOCASE;
"

	match_count="$(
		sqlite3 "$DATABASE" "
SELECT COUNT(*)
FROM domain_rules AS dr
WHERE dr.enabled = 1
  AND (
        (dr.match_type = 'exact'
         AND '$q_domain' = dr.pattern)
     OR (dr.match_type = 'suffix'
         AND (
                '$q_domain' = dr.pattern
             OR '$q_domain' LIKE '%.' || dr.pattern
         ))
  );
"
	)"

	printf '\n'

	if [ "$match_count" -eq 0 ]; then
		printf 'Geen matching regels.\n'
		return
	fi

	printf 'Regelmatches:\n'

	sqlite3 -header -column "$DATABASE" "
SELECT
    dr.pattern,
    dr.match_type,
    c.name AS category,
    dr.source,
    dr.priority,
    dr.enabled
FROM domain_rules AS dr
JOIN categories AS c
    ON c.id = dr.category_id
WHERE dr.enabled = 1
  AND (
        (dr.match_type = 'exact'
         AND '$q_domain' = dr.pattern)
     OR (dr.match_type = 'suffix'
         AND (
                '$q_domain' = dr.pattern
             OR '$q_domain' LIKE '%.' || dr.pattern
         ))
  )
ORDER BY
    dr.priority DESC,
    CASE dr.match_type
        WHEN 'exact' THEN 2
        WHEN 'suffix' THEN 1
        ELSE 0
    END DESC,
    length(dr.pattern) DESC;
"
}

classify_domain() {
	require_root

	domain="$(validate_domain "$1")"
	category="$(validate_category "$2")"
	match_type="$(validate_match_type "${3:-suffix}")"
	priority="${4:-1000}"

	[ "$(category_exists "$category")" -gt 0 ] ||
		fail "onbekende categorie: $category; gebruik dns-analytics-review categories"

	priority="$(safe_integer "$priority" -1)"
	[ "$priority" -ge 0 ] ||
		fail "prioriteit moet een positief geheel getal zijn"
	[ "$priority" -le 100000 ] ||
		fail "prioriteit is te hoog"

	ensure_directory "$(dirname "$LOCAL_RULES")"

	overwriting="$(local_rule_exists "$domain" "$match_type")"

	tmp_file="$RUNTIME_DIR/local-rules.$$"
	trap 'rm -f "$tmp_file"' EXIT INT TERM HUP

	if [ -f "$LOCAL_RULES" ]; then
		awk -F '\t' \
			-v pattern="$domain" \
			-v match_type="$match_type" '
			BEGIN {
				OFS = "\t"
			}

			/^#/ || NF == 0 {
				print
				next
			}

			!($1 == pattern && $2 == match_type) {
				print
			}
			' "$LOCAL_RULES" > "$tmp_file"
	else
		printf '# pattern\tmatch_type\tcategory\tpriority\n' > "$tmp_file"
	fi

	printf '%s\t%s\t%s\t%s\n' \
		"$domain" \
		"$match_type" \
		"$category" \
		"$priority" >> "$tmp_file"

	cp "$tmp_file" "$LOCAL_RULES"
	chmod 0644 "$LOCAL_RULES"

	q_domain="$(sql_quote "$domain")"

	sqlite3 "$DATABASE" "
UPDATE domains
SET classification_status = 'pending',
    updated_at = unixepoch()
WHERE domain = '$q_domain'
COLLATE NOCASE;
"

	"$DB_SYNC_RULES"
	"$DB_RECLASSIFY"

	if [ "$overwriting" -eq 1 ]; then
		printf 'Bestaande lokale regel overschreven.\n'
	fi

	printf 'Geclassificeerd: %s -> %s (%s, prioriteit %s)\n' \
		"$domain" \
		"$category" \
		"$match_type" \
		"$priority"

	audit_log \
		"manual classify: $domain -> $category ($match_type, priority=$priority)"
}

unclassify_domain() {
	require_root

	domain="$(validate_domain "$1")"
	match_type="$(validate_match_type "${2:-suffix}")"

	[ -f "$LOCAL_RULES" ] ||
		fail "er bestaan nog geen lokale regels"

	[ "$(local_rule_exists "$domain" "$match_type")" -eq 1 ] ||
		fail "lokale regel niet gevonden: $domain ($match_type)"

	tmp_file="$RUNTIME_DIR/local-rules.$$"
	trap 'rm -f "$tmp_file"' EXIT INT TERM HUP

	awk -F '\t' \
		-v pattern="$domain" \
		-v match_type="$match_type" '
		BEGIN {
			OFS = "\t"
		}

		/^#/ || NF == 0 {
			print
			next
		}

		!($1 == pattern && $2 == match_type) {
			print
		}
		' "$LOCAL_RULES" > "$tmp_file"

	cp "$tmp_file" "$LOCAL_RULES"
	chmod 0644 "$LOCAL_RULES"

	q_domain="$(sql_quote "$domain")"

	sqlite3 "$DATABASE" "
UPDATE domains
SET classification_status = 'pending',
    updated_at = unixepoch()
WHERE domain = '$q_domain'
COLLATE NOCASE;
"

	"$DB_SYNC_RULES"
	"$DB_RECLASSIFY"

	printf 'Lokale classificatie verwijderd: %s (%s)\n' \
		"$domain" \
		"$match_type"

	audit_log "manual unclassify: $domain ($match_type)"
}

ignore_domain() {
	require_root

	domain="$(validate_domain "$1")"
	q_domain="$(sql_quote "$domain")"

	found="$(
		sqlite3 "$DATABASE" "
SELECT COUNT(*)
FROM domains
WHERE domain = '$q_domain'
COLLATE NOCASE;
"
	)"

	[ "$found" -gt 0 ] || fail "domein niet gevonden: $domain"

	sqlite3 "$DATABASE" "
BEGIN IMMEDIATE;

UPDATE domains
SET classification_status = 'ignored',
    updated_at = unixepoch()
WHERE domain = '$q_domain'
COLLATE NOCASE;

DELETE FROM classification_queue
WHERE domain_id IN (
    SELECT id
    FROM domains
    WHERE domain = '$q_domain'
    COLLATE NOCASE
);

COMMIT;
"

	printf 'Genegeerd: %s\n' "$domain"
	audit_log "manual ignore: $domain"
}

reset_domain() {
	require_root

	domain="$(validate_domain "$1")"
	q_domain="$(sql_quote "$domain")"

	found="$(
		sqlite3 "$DATABASE" "
SELECT COUNT(*)
FROM domains
WHERE domain = '$q_domain'
COLLATE NOCASE;
"
	)"

	[ "$found" -gt 0 ] || fail "domein niet gevonden: $domain"

	sqlite3 "$DATABASE" "
UPDATE domains
SET classification_status = 'pending',
    updated_at = unixepoch()
WHERE domain = '$q_domain'
COLLATE NOCASE;
"

	"$DB_RECLASSIFY"

	printf 'Reviewstatus opnieuw bepaald: %s\n' "$domain"
	audit_log "manual reset: $domain"
}

command="${1:-}"

case "$command" in
	list)
		[ "$#" -le 2 ] ||
			fail "gebruik: dns-analytics-review list [aantal]"
		list_unknown "${2:-30}"
		;;
	show)
		[ "$#" -eq 2 ] ||
			fail "gebruik: dns-analytics-review show <domein>"
		show_domain "$2"
		;;
	categories)
		[ "$#" -eq 1 ] ||
			fail "gebruik: dns-analytics-review categories"
		list_categories
		;;
	stats)
		[ "$#" -eq 1 ] ||
			fail "gebruik: dns-analytics-review stats"
		show_stats
		;;
	classify)
		if [ "$#" -lt 3 ] || [ "$#" -gt 5 ]; then
			fail "gebruik: dns-analytics-review classify <domein> <categorie> [exact|suffix] [prioriteit]"
		fi

		classify_domain "$2" "$3" "${4:-suffix}" "${5:-1000}"
		;;
	unclassify)
		if [ "$#" -lt 2 ] || [ "$#" -gt 3 ]; then
			fail "gebruik: dns-analytics-review unclassify <domein> [exact|suffix]"
		fi

		unclassify_domain "$2" "${3:-suffix}"
		;;
	ignore)
		[ "$#" -eq 2 ] ||
			fail "gebruik: dns-analytics-review ignore <domein>"
		ignore_domain "$2"
		;;
	reset)
		[ "$#" -eq 2 ] ||
			fail "gebruik: dns-analytics-review reset <domein>"
		reset_domain "$2"
		;;
	-h|--help|help|'')
		usage
		;;
	*)
		usage >&2
		exit 1
		;;
esac
