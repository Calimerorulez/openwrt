#!/bin/sh

set -u

DEFAULT_STATE_DIR="/etc/dns-analytics/data"
DEFAULT_DATABASE="$DEFAULT_STATE_DIR/dns-analytics.sqlite"

json_string() {
    printf '%s' "$1" |
    sed \
        -e 's/\\/\\\\/g' \
        -e 's/"/\\"/g' \
        -e ':a;N;$!ba;s/\n/\\n/g'
}

json_number() {
    case "${1:-}" in
        ''|*[!0-9]*)
            printf '0'
            ;;
        *)
            printf '%s' "$1"
            ;;
    esac
}

sqlite_value() {
    sqlite3 \
        -batch \
        -noheader \
        "$DATABASE" \
        "$1" \
        2>/dev/null |
    sed -n '1p'
}

state_dir="$(
    uci -q get dns-analytics.main.state_dir 2>/dev/null
)"

[ -n "$state_dir" ] || state_dir="$DEFAULT_STATE_DIR"

DATABASE="$(
    uci -q get dns-analytics.main.database 2>/dev/null
)"

[ -n "$DATABASE" ] || DATABASE="$state_dir/dns-analytics.sqlite"
[ -n "$DATABASE" ] || DATABASE="$DEFAULT_DATABASE"

package_version="$(
    apk list -I 2>/dev/null |
    sed -n 's/^dns-analytics-\([^ ]*\).*/\1/p' |
    sed -n '1p'
)"

database_exists=0
database_size=0
schema_version=""
application_version=""
watermark=""
total_queries=0
unique_domains=0
pending_domains=0
enabled_categories=0

if [ -f "$DATABASE" ]; then
    database_exists=1

    database_size="$(
        wc -c < "$DATABASE" 2>/dev/null |
        tr -d '[:space:]'
    )"

    schema_version="$(
        sqlite_value "
SELECT value
FROM metadata
WHERE key = 'schema_version'
LIMIT 1;
"
    )"

    application_version="$(
        sqlite_value "
SELECT value
FROM metadata
WHERE key = 'application_version'
LIMIT 1;
"
    )"

    watermark="$(
        sqlite_value "
SELECT value
FROM metadata
WHERE key = 'last_query_time'
LIMIT 1;
"
    )"

    total_queries="$(
        sqlite_value "
SELECT COALESCE(SUM(query_count), 0)
FROM domains;
"
    )"

    unique_domains="$(
        sqlite_value "
SELECT COUNT(*)
FROM domains;
"
    )"

    pending_domains="$(
        sqlite_value "
SELECT COUNT(*)
FROM domains
WHERE classification_status = 'pending';
"
    )"

    enabled_categories="$(
        sqlite_value "
SELECT COUNT(*)
FROM categories
WHERE enabled = 1;
"
    )"
fi

collector_count=0
collector_valid=0

for status_file in /proc/[0-9]*/status; do
    [ -r "$status_file" ] || continue

    pid="${status_file#/proc/}"
    pid="${pid%/status}"

    [ -r "/proc/$pid/cmdline" ] || continue

    cmdline="$(
        tr '\000' ' ' < "/proc/$pid/cmdline" 2>/dev/null
    )"

    case "$cmdline" in
        *"/usr/libexec/dns-analytics/collector"*)
            collector_count=$((collector_count + 1))

            ppid="$(
                awk '/^PPid:/ { print $2 }' "$status_file" 2>/dev/null
            )"

            [ -n "$ppid" ] || continue
            [ -r "/proc/$ppid/cmdline" ] || continue

            parent_cmdline="$(
                tr '\000' ' ' < "/proc/$ppid/cmdline" 2>/dev/null
            )"

            case "$parent_cmdline" in
                /usr/sbin/collectd\ *|*/collectd\ *)
                    collector_valid=$((collector_valid + 1))
                    ;;
            esac
            ;;
    esac
done

collector_running=false

if [ "$collector_count" -eq 1 ] &&
   [ "$collector_valid" -eq 1 ]
then
    collector_running=true
fi

# BEGIN ALPHA2 STATUS CALCULATIONS

collector_configured=false

if uci -q show luci_statistics 2>/dev/null |
   grep -Fq "/usr/libexec/dns-analytics/collector"
then
    collector_configured=true
fi

collector_healthy="${collector_running:-false}"

watermark_age_seconds=0

if [ -n "${watermark:-}" ] &&
   [ -f "$DATABASE" ]
then
    calculated_watermark_age="$(
        sqlite3 "$DATABASE" "
            SELECT CASE
                WHEN strftime('%s', value) IS NULL THEN 0
                WHEN strftime('%s', 'now') < strftime('%s', value) THEN 0
                ELSE strftime('%s', 'now') - strftime('%s', value)
            END
            FROM metadata
            WHERE key = 'last_query_time'
            LIMIT 1;
        " 2>/dev/null
    )"

    case "$calculated_watermark_age" in
        ''|*[!0-9]*)
            watermark_age_seconds=0
            ;;
        *)
            watermark_age_seconds="$calculated_watermark_age"
            ;;
    esac
fi

# END ALPHA2 STATUS CALCULATIONS

printf '{'
printf '"package_version":"%s",' \
    "$(json_string "${package_version:-onbekend}")"
printf '"application_version":"%s",' \
    "$(json_string "${application_version:-onbekend}")"
printf '"schema_version":"%s",' \
    "$(json_string "${schema_version:-onbekend}")"
printf '"database_path":"%s",' \
    "$(json_string "$DATABASE")"
printf '"database_exists":%s,' "$database_exists"
printf '"database_size":%s,' \
    "$(json_number "$database_size")"
printf '"watermark":"%s",' \
    "$(json_string "${watermark:-}")"
printf '"total_queries":%s,' \
    "$(json_number "$total_queries")"
printf '"unique_domains":%s,' \
    "$(json_number "$unique_domains")"
printf '"pending_domains":%s,' \
    "$(json_number "$pending_domains")"
printf '"enabled_categories":%s,' \
    "$(json_number "$enabled_categories")"
printf '"collector_configured":%s,' \
    "${collector_configured:-false}"
printf '"watermark_age_seconds":%s,' \
    "$(json_number "${watermark_age_seconds:-0}")"
printf '"collector_healthy":%s' "${collector_healthy:-false}"
printf '}\n'
