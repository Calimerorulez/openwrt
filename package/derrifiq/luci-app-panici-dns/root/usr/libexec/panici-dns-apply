#!/bin/sh


###############################################################################
# Globale Panici DNS transactielock.
###############################################################################

PANICI_LOCK="/var/lock/panici-dns.lock"
PANICI_LOCK_WAIT="${PANICI_LOCK_WAIT:-120}"

mkdir -p /var/lock

exec 9>"$PANICI_LOCK"

if ! flock -w "$PANICI_LOCK_WAIT" 9; then
    echo "ERROR: timeout waiting for Panici DNS transaction lock" >&2
    exit 75
fi


set -eu

TMP="/tmp/panici-device-overrides.tsv.new"
OUT="/etc/unbound/panici/device-overrides.tsv"
BACKUP="/tmp/panici-device-overrides.tsv.backup.$$"
MARKER="/tmp/panici-dns-apply.changed"

fail() {
    echo "ERROR: $*" >&2
    exit 1
}

apply_dns() {
    rm -f "$MARKER"

    PANICI_BATCH=1 \
    PANICI_CHANGE_MARKER="$MARKER" \
        /usr/bin/udm-dns-sync.sh

    /usr/bin/panici-device-registry-sync.sh

    PANICI_BATCH=1 \
    PANICI_CHANGE_MARKER="$MARKER" \
        /usr/bin/panici-ptr-sync.sh

    unbound-checkconf >/dev/null

    if [ -f "$MARKER" ]; then
        /etc/init.d/unbound reload
    fi

    rm -f "$MARKER"
}

[ -f "$TMP" ] || fail "temporary override file not found"
[ -s "$TMP" ] || fail "temporary override file is empty"

HEADER=$(head -n 1 "$TMP")

[ "$HEADER" = "$(printf 'mac\tcanonical\tdescription\troom\ttype\tidentity\tlifecycle')" ] || \
    fail "invalid TSV header"

awk -F '\t' '
BEGIN {
    failed=0
}

NR == 1 {
    next
}

{
    if (NF != 7) {
        printf "line %d: expected 7 columns, got %d\n", NR, NF > "/dev/stderr"
        failed=1
        next
    }

    mac=tolower($1)
    canonical=$2
    identity=$6
    lifecycle=tolower($7)

    if (lifecycle == "")
        lifecycle="active"

    if (mac !~ /^[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]$/) {
        printf "line %d: invalid MAC address\n", NR > "/dev/stderr"
        failed=1
    }

    if (lifecycle != "active" && lifecycle != "retired") {
        printf "line %d: lifecycle must be active or retired\n", NR > "/dev/stderr"
        failed=1
    }

    if (canonical != "" && canonical !~ /^[A-Za-z0-9][A-Za-z0-9-]*$/) {
        printf "line %d: invalid canonical hostname\n", NR > "/dev/stderr"
        failed=1
    }

    if (mac in seen) {
        printf "line %d: duplicate MAC address\n", NR > "/dev/stderr"
        failed=1
    }

    canonical_key=tolower(canonical)
    identity_key=tolower(identity)

    if (lifecycle == "active" && canonical_key != "" && canonical_key in canonical_seen && canonical_seen[canonical_key] != mac) {
        if (identity_key == "" || canonical_identity[canonical_key] == "" || canonical_identity[canonical_key] != identity_key) {
            printf "line %d: canonical hostname %s is already used by unrelated device %s\n", \
                NR, canonical, canonical_seen[canonical_key] > "/dev/stderr"
            failed=1
        }
    }

    seen[mac]=1

    if (lifecycle == "active" && canonical_key != "" && !(canonical_key in canonical_seen)) {
        canonical_seen[canonical_key]=mac
        canonical_identity[canonical_key]=identity_key
    }
}

END {
    exit failed
}
' "$TMP" || fail "validation failed"

[ ! -f "$OUT" ] || cp "$OUT" "$BACKUP"

mv "$TMP" "$OUT" || fail "could not install override file"

if ! apply_dns; then
    echo "ERROR: DNS apply failed; restoring previous overrides" >&2

    if [ -f "$BACKUP" ]; then
        mv "$BACKUP" "$OUT"
        apply_dns >/dev/null 2>&1 || true
    fi

    exit 1
fi

rm -f "$BACKUP"

echo "OK"
