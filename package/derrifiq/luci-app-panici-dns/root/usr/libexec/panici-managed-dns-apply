#!/bin/sh

set -eu

CANDIDATE_SOURCE="/tmp/panici-managed-records.tsv.new"
LIVE_SOURCE="/etc/panici-dns/managed-records.tsv"

CANDIDATE_CONF="/tmp/panici-managed.conf.candidate"
LIVE_CONF="/etc/unbound/panici/managed.conf"

VALIDATE_CONF="/tmp/panici-managed-unbound-validate.conf"

SOURCE_BACKUP="/tmp/panici-managed-records.tsv.backup.$$"
CONF_BACKUP="/tmp/panici-managed.conf.backup.$$"

OLD_RUNTIME="/tmp/panici-managed-runtime-old.$$"
NEW_RUNTIME="/tmp/panici-managed-runtime-new.$$"
OLD_NAMES="/tmp/panici-managed-runtime-old-names.$$"
NEW_NAMES="/tmp/panici-managed-runtime-new-names.$$"

INCLUDE_FILE="/etc/unbound/unbound_ext.conf"
INCLUDE_LINE='include: "/etc/unbound/panici/managed.conf"'

HAD_SOURCE=0
HAD_CONF=0
INCLUDE_ADDED=0

cleanup() {
    rm -f \
        "$CANDIDATE_CONF" \
        "$VALIDATE_CONF" \
        "$SOURCE_BACKUP" \
        "$CONF_BACKUP" \
        "$OLD_RUNTIME" \
        "$NEW_RUNTIME" \
        "$OLD_NAMES" \
        "$NEW_NAMES"
}
trap cleanup EXIT INT TERM

fail() {
    echo "ERROR: $*" >&2
    exit 1
}

remove_include() {
    TMP_INCLUDE="/tmp/panici-managed-unbound-ext.$$"

    grep -vxF "$INCLUDE_LINE" "$INCLUDE_FILE" > "$TMP_INCLUDE" || true
    mv "$TMP_INCLUDE" "$INCLUDE_FILE"
}

#
# Zet managed.conf om naar runtime records voor unbound-control.
#
# Outputvoorbeeld:
#   host.panici.casa. 3600 IN A 10.0.5.10
#   10.5.0.10.in-addr.arpa. 3600 IN PTR host.panici.casa.
#
conf_to_runtime() {
    FILE="$1"
    OUT="$2"

    : > "$OUT"

    [ -f "$FILE" ] || return 0

    awk '
    $1 == "local-data:" && $3 == "A" {
        name=$2
        ip=$4

        sub(/^"/, "", name)
        sub(/"$/, "", ip)

        print name " 3600 IN A " ip
        next
    }

    $1 == "local-data-ptr:" {
        ip=$2
        name=$3

        sub(/^"/, "", ip)
        sub(/"$/, "", name)

        n=split(ip,a,".")

        if (n == 4) {
            reverse=a[4] "." a[3] "." a[2] "." a[1] ".in-addr.arpa."
            print reverse " 3600 IN PTR " name
        }
    }
    ' "$FILE" > "$OUT"
}

#
# Alleen de owner-namen die local_datas_remove verwacht.
#
runtime_names() {
    INPUT="$1"
    OUTPUT="$2"

    awk '
    NF > 0 {
        print $1
    }
    ' "$INPUT" | sort -u > "$OUTPUT"
}

runtime_remove() {
    FILE="$1"

    [ -s "$FILE" ] || return 0

    if ! unbound-control local_datas_remove < "$FILE"; then
        echo "ERROR: could not remove managed runtime DNS records" >&2
        return 1
    fi
}

runtime_add() {
    FILE="$1"

    [ -s "$FILE" ] || return 0

    if ! unbound-control local_datas < "$FILE"; then
        echo "ERROR: could not add managed runtime DNS records" >&2
        return 1
    fi
}

restore_runtime() {
    #
    # Verwijder eerst alle namen uit de nieuw beoogde runtime-state.
    #
    runtime_remove "$NEW_NAMES" >/dev/null 2>&1 || true

    #
    # Herstel daarna exact de oude managed runtime-RR's.
    #
    runtime_add "$OLD_RUNTIME" >/dev/null 2>&1 || true
}

rollback_live() {
    echo "Rolling back managed DNS state..." >&2

    if [ "$HAD_SOURCE" = "1" ]; then
        cp "$SOURCE_BACKUP" "$LIVE_SOURCE"
    else
        rm -f "$LIVE_SOURCE"
    fi

    if [ "$HAD_CONF" = "1" ]; then
        cp "$CONF_BACKUP" "$LIVE_CONF"
    else
        rm -f "$LIVE_CONF"
    fi

    if [ "$INCLUDE_ADDED" = "1" ]; then
        remove_include
    fi

    restore_runtime
}

[ -f "$CANDIDATE_SOURCE" ] || fail "candidate source not found"
[ -s "$CANDIDATE_SOURCE" ] || fail "candidate source is empty"
[ -f "$INCLUDE_FILE" ] || fail "Unbound include file not found"

mkdir -p /etc/panici-dns /etc/unbound/panici

###############################################################################
# FASE 1
# Candidate volledig compileren; live state nog onaangeraakt.
###############################################################################

if ! /usr/bin/panici-managed-dns-compile \
    "$CANDIDATE_SOURCE" \
    "$CANDIDATE_CONF"
then
    fail "candidate DNS compilation failed"
fi

###############################################################################
# FASE 2
# Complete candidate-config valideren.
###############################################################################

{
    for FILE in /etc/unbound/panici/*.conf; do
        [ -f "$FILE" ] || continue

        case "$FILE" in
            "$LIVE_CONF")
                continue
                ;;
        esac

        printf 'include: "%s"\n' "$FILE"
    done

    printf 'include: "%s"\n' "$CANDIDATE_CONF"
} > "$VALIDATE_CONF"

if ! unbound-checkconf "$VALIDATE_CONF" >/dev/null 2>&1; then
    echo "ERROR: complete candidate Unbound configuration is invalid" >&2
    unbound-checkconf "$VALIDATE_CONF" >&2 || true
    exit 1
fi

###############################################################################
# FASE 3
# Oude en nieuwe managed runtime-state exact bepalen.
###############################################################################

conf_to_runtime "$LIVE_CONF" "$OLD_RUNTIME"
conf_to_runtime "$CANDIDATE_CONF" "$NEW_RUNTIME"

runtime_names "$OLD_RUNTIME" "$OLD_NAMES"
runtime_names "$NEW_RUNTIME" "$NEW_NAMES"

###############################################################################
# FASE 4
# Backups en atomische disk-commit.
###############################################################################

if [ -f "$LIVE_SOURCE" ]; then
    HAD_SOURCE=1
    cp "$LIVE_SOURCE" "$SOURCE_BACKUP"
fi

if [ -f "$LIVE_CONF" ]; then
    HAD_CONF=1
    cp "$LIVE_CONF" "$CONF_BACKUP"
fi

cp "$CANDIDATE_SOURCE" "${LIVE_SOURCE}.new"
cp "$CANDIDATE_CONF" "${LIVE_CONF}.new"

mv "${LIVE_SOURCE}.new" "$LIVE_SOURCE"
mv "${LIVE_CONF}.new" "$LIVE_CONF"

if ! grep -qxF "$INCLUDE_LINE" "$INCLUDE_FILE"; then
    printf '%s\n' "$INCLUDE_LINE" >> "$INCLUDE_FILE"
    INCLUDE_ADDED=1
fi

if ! unbound-checkconf >/dev/null 2>&1; then
    echo "ERROR: live Unbound configuration failed after commit" >&2
    rollback_live
    exit 1
fi

###############################################################################
# FASE 5
# Managed runtime-state zonder resolver reload vervangen.
###############################################################################

if ! runtime_remove "$OLD_NAMES"; then
    rollback_live
    exit 1
fi

if ! runtime_add "$NEW_RUNTIME"; then
    rollback_live
    exit 1
fi

###############################################################################
# FASE 6
# AdGuard-cache best-effort legen.
###############################################################################

ADGUARD_CONFIG="/etc/panici-dns/adguard-cache.conf"

if [ -f "$ADGUARD_CONFIG" ]; then
    # shellcheck disable=SC1090
    . "$ADGUARD_CONFIG"
fi

if [ "${ENABLED:-0}" = "1" ]; then
    if ! command -v curl >/dev/null 2>&1; then
        echo "WARNING: DNS opgeslagen, maar curl ontbreekt; AdGuard-cache niet geleegd" >&2

    elif [ -z "${URL:-}" ]; then
        echo "WARNING: DNS opgeslagen, maar AdGuard cache-URL ontbreekt" >&2

    elif [ -z "${NETRC:-}" ] || [ ! -s "$NETRC" ]; then
        echo "WARNING: DNS opgeslagen, maar AdGuard credentials ontbreken; cache niet geleegd" >&2

    else
        CACHE_RESPONSE="/tmp/panici-adguard-cache-clear.$$"
        CACHE_HTTP=""

        if CACHE_HTTP="$(
            curl \
                --silent \
                --show-error \
                --netrc-file "$NETRC" \
                --request POST \
                --output "$CACHE_RESPONSE" \
                --write-out '%{http_code}' \
                "$URL"
        )"
        then
            if [ "$CACHE_HTTP" = "200" ]; then
                echo "AdGuard cache cleared"
            else
                echo "WARNING: DNS opgeslagen, maar AdGuard cache-clear gaf HTTP $CACHE_HTTP" >&2
            fi
        else
            echo "WARNING: DNS opgeslagen, maar AdGuard cache-clear mislukt" >&2
        fi

        rm -f "$CACHE_RESPONSE"
    fi
fi

rm -f "$CANDIDATE_SOURCE"

echo "OK"
