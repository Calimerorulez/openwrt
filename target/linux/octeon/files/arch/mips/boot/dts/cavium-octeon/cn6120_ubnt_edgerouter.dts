#include "cn6120_ubnt_e20x.dtsi"

/ {
	/* E201 */
	compatible = "er", "ubnt,edgerouter", "ubnt,e200", "cavium,cn61xx";
	model = "Ubiquiti EdgeRouter (ER-8)";
};

&phy2 {
	status = "okay";
};

&phy3 {
	status = "okay";
};

&eth2 {
	phy-mode = "sgmii";
	phy-handle = <&phy2>;
};

&eth3 {
	phy-mode = "sgmii";
	phy-handle = <&phy3>;
};
