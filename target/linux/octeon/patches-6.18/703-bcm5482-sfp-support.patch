+}
+
+static int bcm5482_switch_sfp(struct phy_device *phydev, bool force)
+{
+	struct bcm54xx_phy_priv *priv = phydev->priv;
+	struct device *dev = &phydev->mdio.dev;
+	phy_interface_t interface;
+	int err;
+
+	interface = sfp_select_interface(phydev->sfp_bus, priv->sfp_supported);
+	if (interface == PHY_INTERFACE_MODE_NA)
+		return 0;
+
+	if (!force)
+		dev_info(dev, "switching to %s SFP module PHY\n", phy_modes(interface));
+	err = bcm5482_set_alt_serdes(phydev, true, force);
+	if (err)
+		return err;
+
+	phydev->interface = interface;
+	phy_interface_copy(phydev->possible_interfaces, priv->sfp_interfaces);
+	phydev->port = priv->sfp_port;
+	phydev->link = 0;
+	phydev->autoneg = AUTONEG_DISABLE;
+	return 0;
+}
+
+static int bcm5482_switch_internal(struct phy_device *phydev, bool force)
+{
+	struct device *dev = &phydev->mdio.dev;
+	int err;
+
+	if (!force)
+		dev_info(dev, "switching to internal PHY\n");
+	err = bcm5482_set_alt_serdes(phydev, false, force);
+	if (err)
+		return err;
+
+	phydev->interface = PHY_INTERFACE_MODE_SGMII;
+	phydev->port = PORT_TP;
+	phydev->link = 0;
+	return 0;
+}
+
+static int bcm5482_get_features(struct phy_device *phydev)
+{
+	struct bcm54xx_phy_priv *priv = phydev->priv;
+
+	if (priv->alt_mode)
+		return bcm5482_get_alt_serdes_features(phydev);
+	else if (phydev->is_c45)
+		return genphy_c45_pma_read_abilities(phydev);
+	else
+		return genphy_read_abilities(phydev);
+}
+
+static int bcm5482_sfp_insert(void *upstream, const struct sfp_eeprom_id *id)
+{
+	struct phy_device *phydev = upstream;
+	struct bcm54xx_phy_priv *priv = phydev->priv;
+	__ETHTOOL_DECLARE_LINK_MODE_MASK(phy_supported) = { 0, };
+	int err;
+
+	/* Update SFP PHY information */
+	linkmode_zero(priv->sfp_supported);
+	phy_interface_zero(priv->sfp_interfaces);
+	sfp_parse_support(phydev->sfp_bus, id, priv->sfp_supported, priv->sfp_interfaces);
+	priv->sfp_port = sfp_parse_port(phydev->sfp_bus, id, NULL);
+
+	/* Filter out link modes supported by the PHY */
+	linkmode_set_bit_array(bcm5482_alt_serdes_linkmodes, ARRAY_SIZE(bcm5482_alt_serdes_linkmodes), phy_supported);
+	linkmode_and(priv->sfp_supported, priv->sfp_supported, phy_supported);
+
+	err = bcm5482_switch_sfp(phydev, false);
+	if (err < 0)
+		return err;
+
+	/* update abilities */
+	return bcm5482_get_features(phydev);
+}
+
+static void bcm5482_sfp_remove(void *upstream)
+{
+	struct phy_device *phydev = upstream;
+	struct bcm54xx_phy_priv *priv = phydev->priv;
+	int err;
+
+	linkmode_zero(priv->sfp_supported);
+	phy_interface_zero(priv->sfp_interfaces);
+	priv->sfp_port = PORT_OTHER;
+
+	err = bcm5482_switch_internal(phydev, false);
+	if (err == 0)
+		/* update abilities */
+		bcm5482_get_features(phydev);
+}
+
+static const struct sfp_upstream_ops bcm5482_sfp_ops = {
+	.attach = phy_sfp_attach,
+	.detach = phy_sfp_detach,
+	.module_insert = bcm5482_sfp_insert,
+	.module_remove = bcm5482_sfp_remove,
+	.connect_phy = phy_sfp_connect_phy,
+	.disconnect_phy = phy_sfp_disconnect_phy,
+};
+
+static int bcm5482_phy_probe(struct phy_device *phydev)
+{
+	int err;
+
+	err = bcm54xx_phy_probe(phydev);
+	if (err < 0)
+		return err;
+
+	return phy_sfp_probe(phydev, &bcm5482_sfp_ops);
+}
+
+static int bcm5482_config_init(struct phy_device *phydev)
+{
+	struct bcm54xx_phy_priv *priv = phydev->priv;
+	int err;
+
+	err = bcm54xx_config_init(phydev);
+	if (err < 0)
+		return err;
+
+	if (priv->alt_mode)
+		err = bcm5482_switch_sfp(phydev, true);
+	else
+		err = bcm5482_switch_internal(phydev, true);
+	if (err < 0)
+		return err;
+
+	return 0;
+}
+
+static int bcm5482_config_aneg(struct phy_device *phydev)
+{
+	struct bcm54xx_phy_priv *priv = phydev->priv;
+
+	if (priv->alt_mode)
+		return bcm5482_config_alt_serdes(phydev);
+	else
+		return genphy_config_aneg(phydev);
+}
+
+static int bcm5482_read_status(struct phy_device *phydev)
+{
+	struct bcm54xx_phy_priv *priv = phydev->priv;
+
+	if (priv->alt_mode)
+		return bcm5482_read_alt_serdes_status(phydev);
+	else
+		return genphy_read_status(phydev);
+}
