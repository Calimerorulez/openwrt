+static int bcm5482_set_alt_serdes(struct phy_device *phydev, bool on, bool force)
+{
+	struct bcm54xx_phy_priv *priv = phydev->priv;
+	int err;
+
+	if (on == priv->alt_mode && !force)
+		return 0;
+
+	/* Enable/disable secondary SerDes and set as LED source */
+	err = bcm_phy_toggle_shadow(phydev, BCM5482_SHD_SSD,
+	                                    BCM5482_SHD_SSD_LEDM | BCM5482_SHD_SSD_EN,
+	                                    on);
+	if (err < 0)
+		return err;
+
+	/* Enable/disable SGMII slave mode and auto-detection */
+	err = bcm_phy_toggle_exp(phydev, MII_BCM54XX_EXP_SEL_SSD | BCM5482_SSD_SGMII_SLAVE,
+	                                 BCM5482_SSD_SGMII_SLAVE_EN | BCM5482_SSD_SGMII_SLAVE_AD,
+	                                 on);
+	if (err < 0)
+		return err;
+
+	/* Disable/enable secondary SerDes powerdown */
+	err = bcm_phy_toggle_exp(phydev, MII_BCM54XX_EXP_SEL_SSD | BCM5482_SSD_1000BX_CTL,
+	                                 BCM5482_SSD_1000BX_CTL_PWRDOWN,
+	                                 !on);
+	if (err < 0)
+		return err;
+
+	/* Select/deselect primary SerDes 1000BASE-X register set */
+	err = bcm_phy_toggle_shadow(phydev, BCM54XX_SHD_MODE, BCM54XX_SHD_MODE_1000BX, on);
+	if (err < 0)
+		return err;
+
+	/* Use LED1 as secondary SerDes ACTIVITY LED, or back as multicolor */
+	if (on)
+		err = bcm_phy_write_shadow(phydev, BCM54XX_SHD_LEDS1,
+			BCM54XX_SHD_LEDS1_LED1(BCM_LED_SRC_ACTIVITYLED) |
+			BCM54XX_SHD_LEDS1_LED3(BCM_LED_SRC_LINKSPD2));
+	else
+		err = bcm_phy_write_shadow(phydev, BCM54XX_SHD_LEDS1,
+			BCM54XX_SHD_LEDS1_LED1(BCM_LED_SRC_MULTICOLOR1) |
+			BCM54XX_SHD_LEDS1_LED3(BCM_LED_SRC_MULTICOLOR1));
+	if (err < 0)
+		return err;
+
+	priv->alt_mode = on;
+	return 0;
+}
+
+static int bcm5482_read_alt_serdes_status(struct phy_device *phydev)
+{
+	int val;
+
+	val = bcm_phy_read_shadow(phydev, BCM5482_SHD_SSD);
+	if (val < 0)
+		return val;
+
+	if (val & BCM5482_SHD_SSD_LINK) {
+		phydev->link = 1;
+	} else {
+		phydev->link = 0;
+	}
+
+	if (val & BCM5482_SHD_SSD_FD) {
+		phydev->duplex = DUPLEX_FULL;
+	} else {
+		phydev->duplex = DUPLEX_HALF;
+	}
+
+	if (val & BCM5482_SHD_SSD_100FX_EN) {
+		phydev->speed = SPEED_100;
+	} else {
+		phydev->speed = SPEED_1000;
+	}
+
+	return 0;
+}
+
+static int bcm5482_get_alt_serdes_features(struct phy_device *phydev)
+{
+	struct bcm54xx_phy_priv *priv = phydev->priv;
+
+	linkmode_copy(phydev->supported, priv->sfp_supported);
+	return 0;
+}
