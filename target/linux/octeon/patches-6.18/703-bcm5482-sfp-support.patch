+int bcm_phy_toggle_shadow(struct phy_device *phydev, u16 shadow,
+			  u16 bits, bool on)
+{
+	int val;
+
+	val = bcm_phy_read_shadow(phydev, shadow);
+	if (val < 0)
+		return val;
+
+	if (on)
+		val |= bits;
+	else
+		val &= ~bits;
+
+	return bcm_phy_write_shadow(phydev, shadow, val);
+}
