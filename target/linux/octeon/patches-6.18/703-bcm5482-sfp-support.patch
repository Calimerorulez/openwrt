+int __bcm_phy_toggle_exp(struct phy_device *phydev, u16 reg, u16 bits, bool on)
+{
+	if (on)
+		return __bcm_phy_modify_exp(phydev, reg, 0, bits);
+	else
+		return __bcm_phy_modify_exp(phydev, reg, bits, 0);
+}
+EXPORT_SYMBOL_GPL(__bcm_phy_toggle_exp);
+
+int bcm_phy_toggle_exp(struct phy_device *phydev, u16 reg, u16 bits, bool on)
+{
+	int ret;
+
+	phy_lock_mdio_bus(phydev);
+	ret = __bcm_phy_toggle_exp(phydev, reg, bits, on);
+	phy_unlock_mdio_bus(phydev);
+
+	return ret;
+}
+EXPORT_SYMBOL_GPL(bcm_phy_toggle_exp);
